# Data is not versioned: every input is openly available and is re-fetched on
# demand by `scripts/01_build_city.py` (OSM downloads are cached under
# data/raw/). Keeping the cache out of git is what makes the reproducibility
# claim in the README checkable rather than decorative.
data/raw/
data/interim/
data/processed/
cache/

# Generated outputs.
#
# The small summary tables ARE committed -- they are what the method note cites,
# they diff readably, and they are a few kilobytes each.
#
# The interactive map is NOT committed. It is ~8 MB, it is regenerated in full
# on every run, and a binary-ish blob that changes completely each build would
# bloat the history within a handful of commits. Build it locally with
# `python scripts/03_map.py rotterdam`, or publish it via GitHub Pages / a
# release asset rather than tracking it in the repository.
outputs/**
!outputs/tables/
!outputs/tables/*.csv
!outputs/figures/
!outputs/figures/*.png

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
desktop.ini
